<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>vo_video_list</key>
    <meta>
        <title lang="en">[VO] Video list</title>
        <title lang="de">[VO] Videoliste</title>
    </meta>
    <properties>
        <property name="headline" type="text_line">
            <meta><title lang="en">Headline</title><title lang="de">Überschrift</title></meta>
        </property>
        <property name="intro" type="text_area">
            <meta><title lang="en">Intro</title><title lang="de">Einleitung</title></meta>
        </property>
        <property name="libraryId" type="text_line">
            <meta>
                <title lang="en">Library ID</title>
                <title lang="de">Bibliotheks-ID</title>
                <info_text lang="en">UUID of the VideoOptimizer library to list (empty: all libraries). Only finished videos are shown.</info_text>
                <info_text lang="de">UUID der VideoOptimizer-Bibliothek (leer: alle Bibliotheken). Es werden nur fertige Videos angezeigt.</info_text>
            </meta>
        </property>
        <property name="tags" type="text_line">
            <meta>
                <title lang="en">Tags</title>
                <title lang="de">Tags</title>
                <info_text lang="en">Optional, comma-separated: only videos carrying all of these tags.</info_text>
                <info_text lang="de">Optional, kommagetrennt: nur Videos mit allen diesen Tags.</info_text>
            </meta>
        </property>
        <property name="pageSize" type="number">
            <meta>
                <title lang="en">Videos per page</title>
                <title lang="de">Videos pro Seite</title>
                <info_text lang="en">Default 12.</info_text>
                <info_text lang="de">Standard 12.</info_text>
            </meta>
            <params>
                <param name="min" value="3"/>
                <param name="max" value="24"/>
            </params>
        </property>
        <property name="detailPage" type="text_line">
            <meta>
                <title lang="en">Detail page URL</title>
                <title lang="de">URL der Detailseite</title>
                <info_text lang="en">Page that contains a "Video detail" block, e.g. /video. Cards link to it with ?vo_video=UUID. Empty: cards open the video in a lightbox.</info_text>
                <info_text lang="de">Seite mit einem „Video-Detail“-Block, z. B. /video. Die Karten verlinken mit ?vo_video=UUID dorthin. Leer: Karten öffnen das Video in einer Lightbox.</info_text>
            </meta>
        </property>
        <property name="player" type="single_select">
            <meta><title lang="en">Player</title><title lang="de">Player</title></meta>
            <params>
                <param name="default_value" value="inherit"/>
                <param name="values" type="collection">
                    <param name="inherit"><meta><title lang="en">Global default</title><title lang="de">Globaler Standard</title></meta></param>
                    <param name="hosted"><meta><title lang="en">Hosted player (iframe)</title><title lang="de">Gehosteter Player (iframe)</title></meta></param>
                    <param name="native"><meta><title lang="en">Native player</title><title lang="de">Nativer Player</title></meta></param>
                </param>
            </params>
        </property>
        <property name="autoplay" type="single_select">
            <meta><title lang="en">Autoplay</title><title lang="de">Autoplay</title></meta>
            <params>
                <param name="default_value" value="inherit"/>
                <param name="values" type="collection">
                    <param name="inherit"><meta><title lang="en">Theme default</title><title lang="de">Theme-Standard</title></meta></param>
                    <param name="1"><meta><title lang="en">On</title><title lang="de">An</title></meta></param>
                    <param name="0"><meta><title lang="en">Off</title><title lang="de">Aus</title></meta></param>
                </param>
            </params>
        </property>
        <property name="controls" type="single_select">
            <meta><title lang="en">Player controls</title><title lang="de">Player-Bedienelemente</title></meta>
            <params>
                <param name="default_value" value="inherit"/>
                <param name="values" type="collection">
                    <param name="inherit"><meta><title lang="en">Theme default</title><title lang="de">Theme-Standard</title></meta></param>
                    <param name="1"><meta><title lang="en">On</title><title lang="de">An</title></meta></param>
                    <param name="0"><meta><title lang="en">Off</title><title lang="de">Aus</title></meta></param>
                </param>
            </params>
        </property>
        <property name="loop" type="single_select">
            <meta><title lang="en">Loop</title><title lang="de">Endlosschleife</title></meta>
            <params>
                <param name="default_value" value="inherit"/>
                <param name="values" type="collection">
                    <param name="inherit"><meta><title lang="en">Theme default</title><title lang="de">Theme-Standard</title></meta></param>
                    <param name="1"><meta><title lang="en">On</title><title lang="de">An</title></meta></param>
                    <param name="0"><meta><title lang="en">Off</title><title lang="de">Aus</title></meta></param>
                </param>
            </params>
        </property>
        <property name="muted" type="single_select">
            <meta><title lang="en">Muted</title><title lang="de">Stummgeschaltet</title></meta>
            <params>
                <param name="default_value" value="inherit"/>
                <param name="values" type="collection">
                    <param name="inherit"><meta><title lang="en">Theme default</title><title lang="de">Theme-Standard</title></meta></param>
                    <param name="1"><meta><title lang="en">On</title><title lang="de">An</title></meta></param>
                    <param name="0"><meta><title lang="en">Off</title><title lang="de">Aus</title></meta></param>
                </param>
            </params>
        </property>
        <property name="priority" type="checkbox">
            <meta>
                <title lang="en">Prioritize loading (above the fold)</title>
                <title lang="de">Bevorzugt laden (above the fold)</title>
                <info_text lang="en">Enable for the topmost/LCP block: loads its poster eagerly and skips the fade-in.</info_text>
                <info_text lang="de">Für den obersten/LCP-Block aktivieren: lädt das Poster sofort und überspringt die Einblend-Animation.</info_text>
            </meta>
        </property>
    </properties>
</template>
