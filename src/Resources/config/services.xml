<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <!-- scale_video_optimizer.api_base_url / .embed_base_url are set by the DI extension from config. -->

    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="Scale\VideoOptimizerBundle\Security\TokenCipher">
            <argument>%kernel.secret%</argument>
        </service>

        <service id="Scale\VideoOptimizerBundle\Service\SettingsManager">
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Security\TokenCipher"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Command\InstallCommand">
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument>%kernel.project_dir%</argument>
            <argument type="service" id="sulu.repository.role" on-invalid="null"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Command\UninstallCommand">
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument>%kernel.project_dir%</argument>
        </service>

        <!-- $configuredSiteUrl is set by UserAgentSiteUrlPass from framework.router.default_uri. -->
        <service id="Scale\VideoOptimizerBundle\Api\UserAgentProvider">
            <argument key="$requestStack" type="service" id="request_stack" on-invalid="null"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient">
            <argument type="service" id="http_client"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\SettingsManager"/>
            <argument>%scale_video_optimizer.api_base_url%</argument>
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\UserAgentProvider"/>
            <argument type="service" id="logger" on-invalid="null"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Admin\VideoOptimizerAdmin">
            <argument type="service" id="sulu_admin.view_builder_factory"/>
            <argument type="service" id="sulu_security.security_checker" on-invalid="null"/>
        </service>

        <!-- Enforces the `_vo_permission` requirement of the admin proxy routes. -->
        <service id="Scale\VideoOptimizerBundle\EventListener\AdminPermissionListener">
            <argument type="service" id="sulu_security.security_checker" on-invalid="null"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Content\VideoOptimizerPropertyResolver">
            <tag name="sulu_content.property_resolver"/>
        </service>

        <!-- Shared between the admin and website kernels; replace via the `cache_pool` config option. -->
        <service id="scale_video_optimizer.cache" class="Symfony\Component\Cache\Adapter\FilesystemAdapter">
            <argument>scale_video_optimizer</argument>
            <argument>0</argument>
            <argument>%scale_video_optimizer.cache_directory%</argument>
        </service>

        <service id="Scale\VideoOptimizerBundle\Service\EmbedRenderState">
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Service\VideoOptimizerEmbedResolver">
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient"/>
            <argument type="service" id="scale_video_optimizer.cache"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\EmbedRenderState"/>
            <argument type="service" id="sulu_http_cache.reference_store" on-invalid="null"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\VideoOwnership"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Service\VideoListProvider">
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient"/>
            <argument type="service" id="scale_video_optimizer.cache"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\EmbedRenderState"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Service\VideoOwnership">
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient"/>
            <argument type="service" id="scale_video_optimizer.cache"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\EmbedRenderState"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\SettingsManager"/>
            <argument type="service" id="sulu_http_cache.reference_store" on-invalid="null"/>
        </service>

        <!-- Runs late so it sees the lifetime Sulu's cache-lifetime enhancer already set. -->
        <service id="Scale\VideoOptimizerBundle\EventListener\EmbedPageCacheListener">
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\EmbedRenderState"/>
            <tag name="kernel.event_listener" event="kernel.response" method="onKernelResponse" priority="-1000"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Twig\VideoOptimizerExtension">
            <argument>%scale_video_optimizer.embed_base_url%</argument>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\VideoOptimizerEmbedResolver"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\SettingsManager"/>
            <argument type="service" id="logger" on-invalid="null"/>
            <argument>%scale_video_optimizer.api_base_url%</argument>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\VideoListProvider"/>
            <argument type="service" id="translator" on-invalid="null"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\VideoOwnership"/>
            <tag name="twig.extension"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\EventListener\AssetInjectionListener">
            <argument type="service" id="twig"/>
            <argument>%scale_video_optimizer.auto_inject_assets%</argument>
            <tag name="kernel.event_listener" event="kernel.response" method="onKernelResponse"/>
        </service>

        <!-- Admin proxy controllers -->
        <service id="Scale\VideoOptimizerBundle\Controller\Admin\SettingsController" public="true">
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\SettingsManager"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient"/>
            <argument type="service" id="scale_video_optimizer.cache"/>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- Public webhook receiver (website kernel, route from routing_website.yaml) -->
        <service id="Scale\VideoOptimizerBundle\Controller\WebhookController" public="true">
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\SettingsManager"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\VideoOptimizerEmbedResolver"/>
            <argument type="service" id="scale_video_optimizer.cache"/>
            <argument type="service" id="sulu_http_cache.cache_manager" on-invalid="null"/>
            <argument type="service" id="logger" on-invalid="null"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Controller\Admin\LibraryController" public="true">
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\VideoOptimizerEmbedResolver"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Controller\Admin\SavingsController" public="true">
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Controller\Admin\SubtitleController" public="true">
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\VideoOptimizerEmbedResolver"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Scale\VideoOptimizerBundle\Controller\Admin\VideoController" public="true">
            <argument type="service" id="Scale\VideoOptimizerBundle\Api\VideoOptimizerClient"/>
            <argument type="service" id="Scale\VideoOptimizerBundle\Service\VideoOptimizerEmbedResolver"/>
            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>
