{#
    Video list: cards for one page of the library's finished videos. A card uses the poster the list endpoint
    returns (and a srcset only when the embed data is already cached), so rendering a list makes no per-video API
    call. A card links to the detail page, or opens the hosted embed in the lightbox.
#}
{% set locale = app.request.locale|default('en') %}
{% set cursor = app.request.query.all.vo_cursor|default(null) %}
{% set cursor = cursor is iterable ? null : cursor %}
{% set list = video_optimizer_videos(block.libraryId|default(null), block.tags|default(null), cursor, block.pageSize|default(null)) %}
{% set playerOpts = video_optimizer_player_options(block) %}
{% set slug = video_optimizer_page_slug(block.detailPage|default(null)) %}
{% set pagePath = slug ? sulu_content_path(slug) : null %}
{% set requestUri = app.request.requestUri|default('/') %}
<section class="vo-block vo-list{% if not block.priority|default(false) %} vo-reveal{% endif %}">
    <div class="vo-container">
        {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
        {% if block.intro %}<p class="vo-grid__intro">{{ block.intro }}</p>{% endif %}
        {% if list.items %}
            <!--vo-assets-->
            <ul class="vo-list__items">
                {% for item in list.items %}
                    {% set href = video_optimizer_detail_url(pagePath, item.uuid) %}
                    {% set title = item.title|default(video_optimizer_t('play', locale)) %}
                    {% set srcset = video_optimizer_card_srcset(item.uuid) %}
                    {% set eager = block.priority|default(false) and loop.first %}
                    {% set thumb %}
                        {% if item.poster %}<img class="vo-poster__img" src="{{ item.poster }}"{% if srcset %} srcset="{{ srcset }}" sizes="(min-width: 900px) 360px, (min-width: 560px) 45vw, 100vw"{% endif %} width="640" height="360" alt="" loading="{{ eager ? 'eager' : 'lazy' }}" decoding="async"{% if eager %} fetchpriority="high"{% endif %}>{% endif %}
                        <span class="vo-poster__play" aria-hidden="true">▶</span>
                    {% endset %}
                    {% set body %}
                        <span class="vo-list__body">
                            <span class="vo-list__title">{{ title }}</span>
                            {% if item.duration %}<span class="vo-list__meta">{{ video_optimizer_duration(item.duration) }}</span>{% endif %}
                        </span>
                    {% endset %}
                    <li class="vo-list__item">
                        {% if href %}
                            <span class="vo-list__thumb" aria-hidden="true">{{ thumb }}</span>
                            <span class="vo-list__body">
                                <a class="vo-list__title vo-list__link" href="{{ href }}">{{ title }}</a>
                                {% if item.duration %}<span class="vo-list__meta">{{ video_optimizer_duration(item.duration) }}</span>{% endif %}
                            </span>
                        {% else %}
                            <button type="button" class="vo-list__card" data-vo-lightbox="{{ video_optimizer_embed_url({uuid: item.uuid}, playerOpts) }}" data-vo-player="hosted">
                                <span class="vo-list__thumb">{{ thumb }}</span>
                                {{ body }}
                            </button>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% if list.next or cursor %}
                <nav class="vo-list__pager" aria-label="{{ video_optimizer_t('pagination', locale) }}">
                    {% if cursor %}<a class="vo-btn vo-btn--ghost" href="{{ video_optimizer_cursor_url(requestUri, null) }}">{{ video_optimizer_t('first', locale) }}</a>{% endif %}
                    {% if list.next %}<a class="vo-btn" href="{{ video_optimizer_cursor_url(requestUri, list.next) }}" rel="next">{{ video_optimizer_t('next', locale) }}</a>{% endif %}
                </nav>
            {% endif %}
        {% else %}
            <!--vo-assets-->
            <p class="vo-list__empty" role="status">{{ video_optimizer_t(list.error ? 'unavailable' : 'no_videos', locale) }}</p>
        {% endif %}
    </div>
</section>
